[Unit]
Description=GameOS performance tuning (always-on gamemode-style optimizations)
# Run before the kiosk session so the governor + sysctls are already
# in effect by the time Minecraft's first frame is drawn.
Before=gameos.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/gameos-performance
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!--
  labwc config for the GameOS kiosk session. Kept minimal: we override
  labwc's defaults only where we want them suppressed.

  The default rc.xml binds right-click on the root surface to the system
  "root-menu" (Terminal / Reconfigure / Exit). On a kiosk that menu is a
  trapdoor out of the appliance, so we override the Root context with an
  explicit no-op binding instead of relying on default-merging behavior.
-->
<labwc_config>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="None" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>

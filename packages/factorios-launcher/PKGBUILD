# Maintainer: FactoriOS
pkgname=gameos-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Shared game launcher library for GameOS"
arch=('any')
url="https://example.invalid/gameos"
license=('MIT')
depends=('python' 'python-requests')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=()
options=(!debug)

# Monorepo: pull the launcher/ source tree from two levels up.
prepare() {
    rm -rf "$srcdir/launcher"
    cp -r "$startdir/../../launcher" "$srcdir/launcher"
}

build() {
    cd "$srcdir/launcher"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/launcher"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # /var/lib/gameos is owned by this package.
    install -d -m 0755 "$pkgdir/var/lib/gameos"
    install -d -m 0755 "$pkgdir/var/lib/gameos/versions"
    install -d -m 0755 "$pkgdir/var/lib/gameos/users"
    install -d -m 0755 "$pkgdir/var/lib/gameos/providers"
}
